				{
					"name": "Sign-in Staff",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const responseJson = pm.response.json();",
									"if (responseJson && responseJson.access_token) {",
									"    pm.globals.set(\"staff_token\", responseJson.access_token);",
									"}"
								],
								"type": "text/javascript"
							}
